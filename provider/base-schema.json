{
  "name": "anvil",
  "version": "0.0.13",
  "language": {
    "nodejs": {
      "packageName": "@anvil-cloud/sdk",
      "dependencies": {
        "@pulumi/pulumi": "^3.0.0",
        "@pulumi/aws": "^7.21.0",
        "@pulumi/gcp": "^9.0.0"
      }
    },
    "python": {
      "packageName": "anvil_cloud",
      "requires": {
        "pulumi": ">=3.0.0,<4.0.0",
        "pulumi-aws": "^7.21.0",
        "pulumi-gcp": "^9.0.0"
      }
    },
    "go": {
      "generateResourceContainerTypes": true,
      "importBasePath": "github.com/DamienPace15/anvil/sdk/go/anvil"
    },
    "csharp": {
      "packageReferences": {
        "Pulumi": "3.*",
        "Pulumi.Aws": "7.*"
      },
      "rootNamespace": "Anvil"
    },
    "java": {
      "basePackage": "com.anvil.pulumi",
      "buildFiles": "gradle"
    }
  },
  "resources": {},
  "types": {
    "anvil:index:ComplianceFramework": {
      "type": "string",
      "enum": [
        { "value": "soc2", "description": "SOC 2 Type II" },
        { "value": "iso27001", "description": "ISO/IEC 27001" },
        { "value": "cis", "description": "CIS AWS Foundations Benchmark" },
        { "value": "pci-dss", "description": "PCI DSS" },
        { "value": "hipaa", "description": "HIPAA" },
        { "value": "fedramp", "description": "FedRAMP" },
        { "value": "hitrust", "description": "HITRUST CSF" },
        { "value": "gdpr", "description": "GDPR" },
        { "value": "soc1", "description": "SOC 1 Type II" },
        { "value": "irap", "description": "IRAP (Australian Government)" },
        { "value": "nist-csf", "description": "NIST Cybersecurity Framework" },
        { "value": "csa-star", "description": "CSA STAR" }
      ]
    }
  }
}
